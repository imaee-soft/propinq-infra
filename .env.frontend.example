# Frontend (contenedor nginx). Cargado con env_file en docker-compose (home y prod).
# Controla si el mapa del home llama GET /api/v1/pois/within
# false = local y producción (recomendado mientras no haya import OSM)
# true  = mostrar POIs en el mapa (requiere datos en tabla poi)
MAP_POIS_ENABLED=false
